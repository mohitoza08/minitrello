# Copy this file to .env and adjust values as needed.
# Local development
PORT=5000

# Supabase project (https://supabase.com)
# 1. Create a free project on Supabase
# 2. Project Settings -> Data API -> copy these values
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# Optional: used only by `npm run setup-db` (creates the tasks table + seed)
# Postgres connection string from Dashboard -> Connect -> Transaction pooler
SUPABASE_DB_URL=postgresql://postgres.<your-project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres